# Ansible managed: Linux Security Baseline AIDE daily integrity check.
SHELL={{ linux_security_baseline_aide_cron.shell }}
PATH={{ linux_security_baseline_aide_cron.path_env }}
MAILTO="{{ linux_security_baseline_aide_cron.mailto }}"

{% set schedule_parts = [
  linux_security_baseline_aide_cron.minute,
  linux_security_baseline_aide_cron.hour,
  linux_security_baseline_aide_cron.day,
  linux_security_baseline_aide_cron.month,
  linux_security_baseline_aide_cron.weekday
] %}
{{ schedule_parts | join(' ') }} {{ linux_security_baseline_aide_cron.user }} {{ linux_security_baseline_aide_cron.command }}
